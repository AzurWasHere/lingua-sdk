{
  "name": "@lingua-api/core",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Lingua",
  "homepage": "https://github.com/AzurWasHere/lingua-sdk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/AzurWasHere/lingua-sdk.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@lingua-api/client": "workspace:*",
    "jiti": "^2.7.0",
    "oxc-parser": "^0.153.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@lingua-api/shared": "workspace:*"
  },
  "peerDependencies": {
    "@vue/compiler-sfc": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "@vue/compiler-sfc": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
