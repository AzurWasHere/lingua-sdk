{
  "name": "lingua-sdk-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:examples": "pnpm -r --filter \"./examples/*\" build",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "i18next": "^26.4.2",
    "jsdom": "^26.1.0",
    "next": "^16.3.8",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-intl": "^12.1.4",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13"
  }
}
