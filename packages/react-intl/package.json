{
  "name": "@lingua-api/react-intl",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "author": "Lingua",
  "homepage": "https://github.com/AzurWasHere/lingua-sdk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/AzurWasHere/lingua-sdk.git",
    "directory": "packages/react-intl"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsdown --watch"
  },
  "devDependencies": {
    "@lingua-api/shared": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-intl": ">=6"
  },
  "publishConfig": {
    "access": "public"
  }
}
